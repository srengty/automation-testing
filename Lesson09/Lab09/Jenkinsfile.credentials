// Exercise 5 — inject secrets safely.
// First add credentials in Manage Jenkins -> Credentials:
//   * a "Secret text"        with ID  demo-token
//   * a "Username/password"  with ID  dockerhub
pipeline {
    agent any

    environment {
        APP_ENV   = 'staging'
        // Bind a Secret text credential to an env var (masked in logs).
        API_TOKEN = credentials('demo-token')
    }

    stages {
        stage('Show env') {
            steps {
                // Demonstrates masking: the token value is replaced with **** in the log.
                sh 'echo "Env: $APP_ENV"'
                sh 'echo "Token is set, length: ${#API_TOKEN}"'
            }
        }
        stage('Login with username/password') {
            steps {
                withCredentials([usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS')]) {
                    sh 'echo "Logging in as $REG_USER (password hidden)"'
                    // e.g. echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
                }
            }
        }
    }
}
