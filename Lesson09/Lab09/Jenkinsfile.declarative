// Exercise 3 — a minimal declarative pipeline.
// New Item -> Pipeline -> paste this, or use "Pipeline script from SCM".
pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Build') {
            steps {
                echo "Building #${env.BUILD_NUMBER} on ${env.NODE_NAME}"
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }
    }

    post {
        always  { echo 'Pipeline finished (this always runs).' }
        success { echo '✔ Pipeline green' }
        failure { echo '✗ Build failed' }
    }
}
